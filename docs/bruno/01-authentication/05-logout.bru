meta {
  name: Logout
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/auth/logout
  body: none
  auth: none
}

headers {
  X-CSRF-Token: {{csrf_token}}
}

docs {
  Revoke current refresh token in database and clear all authentication cookies.
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
