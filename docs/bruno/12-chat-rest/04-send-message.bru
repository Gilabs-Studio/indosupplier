meta {
  name: Send Chat Message
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/buyer/chat/rooms/{{room_id}}/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "body": "Halo, apakah stok jahe gajah organik siap untuk pengiriman minggu depan?"
  }
}

vars:pre-request {
  base_url: http://localhost:8088
  room_id: fe666721-371d-4108-bb6e-00e3af635fc6
}

docs {
  Sends a chat message to the specified chat room via REST API.
}
