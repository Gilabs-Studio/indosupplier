meta {
  name: Create or Get Chat Room
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/buyer/chat/rooms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "supplier_profile_id": "ecd61c81-ec5f-4676-be35-da8d6ef6e561"
  }
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Initiates a chat conversation room with a supplier or returns an existing one.
}
