meta {
  name: Add Product to Compare
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/buyer/compare/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "supplierProductId": "82a33e7c-b6cd-4e43-b95f-10fbcb4fe1dc"
  }
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Adds a product to the product comparison session (maximum 4 products).
}
