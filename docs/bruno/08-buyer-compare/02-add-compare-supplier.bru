meta {
  name: Add Supplier to Compare
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/buyer/compare
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "supplierProfileId": "ecd61c81-ec5f-4676-be35-da8d6ef6e561"
  }
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Adds a supplier to the comparison session (maximum 4 suppliers).
}
