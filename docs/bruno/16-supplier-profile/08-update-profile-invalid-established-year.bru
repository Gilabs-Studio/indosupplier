meta {
  name: Update Profile - Invalid Non-Numeric Established Year
  type: http
  seq: 8
}

put {
  url: {{base_url}}/api/v1/supplier/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "companyName": "PT Baja Sentosa Sukses Makmur",
    "businessType": "PT",
    "established": "dua ribu delapan belas",
    "employees": "50-100",
    "email": "contact@bajasentosa.co.id",
    "phone": "+6281234567890",
    "website": "https://bajasentosa.co.id",
    "taxId": "01.234.567.8-901.000",
    "nib": "9120001234567",
    "overview": "Distributor besi dan baja konstruksi terkemuka.",
    "location": "Jl. Industri Raya Blok C No. 12, Cikarang"
  }
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Edge case testing: Passing alphabetic non-numeric string for "established" (Tahun Berdiri).
  Expected: 400 Bad Request with VALIDATION_ERROR for field "established".
}
