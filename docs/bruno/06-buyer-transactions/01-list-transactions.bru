meta {
  name: List Transactions
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/buyer/transactions?page=1&per_page=10&status=all
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
  status: all
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Lists purchase orders and transactions for the authenticated buyer.
}
