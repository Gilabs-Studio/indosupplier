meta {
  name: Reply to Review (Update Existing)
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/supplier/reviews/{{review_id}}/reply
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "reply": "Pembaruan tanggapan: Terima kasih banyak atas masukan Anda. Kami telah menambahkan kapasitas armada pengiriman untuk memastikan proses pengadaan lebih lancar."
  }
}

vars:pre-request {
  base_url: http://localhost:8088
  review_id: c14a112e-ac8f-4400-98e6-e86d580e65a8
}

docs {
  Updates an existing supplier reply with revised notes or additional logistics information.
}
