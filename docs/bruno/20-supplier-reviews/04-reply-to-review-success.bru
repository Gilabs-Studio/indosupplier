meta {
  name: Reply to Review (Success)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/supplier/reviews/{{review_id}}/reply
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "reply": "Terima kasih atas ulasannya! Kami senang material yang dikirimkan sesuai dengan kebutuhan proyek Anda."
  }
}

vars:pre-request {
  base_url: http://localhost:8088
  review_id: c14a112e-ac8f-4400-98e6-e86d580e65a8
}

docs {
  Submits an official supplier response/reply to an approved buyer review.
  Also sends an in-app notification to the buyer informing them of the response.
}
