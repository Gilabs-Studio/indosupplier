meta {
  name: Get Supplier Reviews
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/supplier/reviews?page=1&limit=10
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 10
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Lists all verified buyer reviews and store rating stats for the authenticated supplier.
  Includes pagination, aggregate review stats (total, average rating, replied/unreplied counts, star breakdown).
}
