meta {
  name: Filter Supplier Reviews by Rating
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/supplier/reviews?page=1&limit=10&rating=5
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 10
  rating: 5
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Filters supplier reviews to show only 5-star ratings.
}
