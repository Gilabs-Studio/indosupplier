meta {
  name: List Users
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/users?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Lists all registered users in the platform (paginated).
  Requires authenticated session cookie.
}
