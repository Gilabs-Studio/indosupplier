meta {
  name: List Bookmarks
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/buyer/bookmarks
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Lists all bookmarks (both suppliers and products) saved by the authenticated buyer.
  Requires active user session cookie (`access_token`) and `X-CSRF-Token` header.
}
