meta {
  name: List Notifications
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/buyer/notifications
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Lists all in-app notifications for the buyer.
}
