meta {
  name: Create Support Ticket
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/buyer/support/tickets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "subject": "Pertanyaan Validasi Dokumen NIB",
    "message": "Halo tim IndoSupplier, dokumen NIB kami sudah diupload, mohon dicek estimasi verifikasinya."
  }
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Creates a new customer support ticket.
}
