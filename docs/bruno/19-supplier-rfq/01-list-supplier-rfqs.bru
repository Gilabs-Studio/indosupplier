meta {
  name: 01 List Supplier RFQs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/supplier/rfqs
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data: isDefined
}

script:post-response {
  const data = res.getBody();
  if (data && data.data && data.data.length > 0) {
    bru.setEnvVar('test_rfq_id', data.data[0].id);
  }
}

docs {
  Lists all RFQs received by the authenticated supplier profile.
}
