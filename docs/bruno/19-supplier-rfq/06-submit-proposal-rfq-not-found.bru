meta {
  name: 06 Submit Proposal RFQ Not Found (Edge Case)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/supplier/rfqs/00000000-0000-0000-0000-000000000000/proposals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "price": "Rp 10.000.000",
    "moq": "1 Ton",
    "deliveryTime": "3 Hari",
    "notes": "Testing not found proposal"
  }
}

vars:pre-request {
  base_url: http://localhost:8088
}

assert {
  res.status: in [400, 404]
  res.body.success: eq false
}

docs {
  Tests edge case: submitting proposal to a non-existent RFQ UUID returns 404 Not Found.
}
