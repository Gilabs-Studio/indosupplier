meta {
  name: 07 List Supplier Notifications
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/v1/supplier/notifications
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data: isDefined
}

docs {
  Retrieves in-app notifications for the supplier.
}
