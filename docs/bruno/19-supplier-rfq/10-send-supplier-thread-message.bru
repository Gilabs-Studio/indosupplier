meta {
  name: 10 Send Supplier Thread Message
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/v1/supplier/rfqs/{{test_rfq_id}}/thread/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "body": "Kami siap memenuhi jadwal pengiriman sesuai target.",
    "price": "Rp 12.000.000 / Ton",
    "moq": "5 Ton",
    "deliveryTime": "5 Hari Kerja"
  }
}

vars:pre-request {
  base_url: http://localhost:8088
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data: isDefined
}

docs {
  Sends a negotiation reply or updated quotation in the RFQ discussion thread.
}
