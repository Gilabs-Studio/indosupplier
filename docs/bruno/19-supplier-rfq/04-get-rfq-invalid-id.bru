meta {
  name: 04 Get RFQ Invalid ID (Edge Case)
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/supplier/rfqs/invalid-uuid-random-1234
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

assert {
  res.status: in [400, 404]
  res.body.success: eq false
}

docs {
  Tests edge case: supplying a malformed/non-existent RFQ UUID returns an error response.
}
