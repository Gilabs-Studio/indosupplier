meta {
  name: List Review History
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/buyer/reviews/history
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Retrieves past reviews and ratings submitted by the authenticated buyer.
}
