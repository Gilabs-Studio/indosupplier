meta {
  name: List Eligible Reviews
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/buyer/reviews/eligible
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Lists all completed purchase orders that are eligible to be reviewed by the buyer.
}
