meta {
  name: List RFQs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/buyer/rfqs?status=all
  body: none
  auth: none
}

params:query {
  status: all
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Lists all Request for Quotations (RFQs) created by the authenticated buyer.
}
