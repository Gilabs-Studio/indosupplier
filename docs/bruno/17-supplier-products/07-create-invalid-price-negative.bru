meta {
  name: Create Product - Invalid Negative Price
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/supplier/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "category_id": "1e48ff95-01cf-486b-ad2a-c407ed1c1225",
    "name": "Besi WF Beam 200",
    "description": "Besi WF Beam ukuran 200x100x5.5x8mm untuk konstruksi gedung.",
    "starting_price": -50000,
    "moq": "1 Batang"
  }
}

vars:pre-request {
  base_url: http://localhost:8088
}

docs {
  Tests validation rejection when starting_price is negative (< 0).
  Expected Response: HTTP 400 Bad Request with code `VALIDATION_ERROR` on starting_price.
}
